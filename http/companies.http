### Variables
@baseUrl = http://localhost:8080/api/v1
@adminToken = <paste_admin_token_here>
@recruiterToken = <paste_recruiter_token_here>
@companyId = <paste_company_id_here>


### ─────────────────────────────────────────
### Create a company (admin only — expect 201)
### ─────────────────────────────────────────
POST {{baseUrl}}/companies
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "TechCorp Lanka",
  "description": "A leading software company in Sri Lanka.",
  "industry": "Technology",
  "website": "https://techcorplanka.com",
  "location": "Colombo, Sri Lanka"
}


### ─────────────────────────────────────────
### Create a company as recruiter (expect 403)
### ─────────────────────────────────────────
POST {{baseUrl}}/companies
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "name": "Fake Company",
  "description": "Should not be created.",
  "industry": "Finance",
  "website": "https://fake.com",
  "location": "Galle, Sri Lanka"
}


### ─────────────────────────────────────────
### Create a company — no token (expect 401)
### ─────────────────────────────────────────
POST {{baseUrl}}/companies
Content-Type: application/json

{
  "name": "Ghost Company",
  "description": "No auth provided.",
  "industry": "Retail",
  "website": "https://ghost.com",
  "location": "Kandy, Sri Lanka"
}


### ─────────────────────────────────────────
### Create a company — missing required fields (expect 422)
### ─────────────────────────────────────────
POST {{baseUrl}}/companies
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Incomplete Co"
}


### ─────────────────────────────────────────
### Get all companies (public — expect 200)
### ─────────────────────────────────────────
GET {{baseUrl}}/companies


### ─────────────────────────────────────────
### Get company by ID (public — expect 200)
### ─────────────────────────────────────────
GET {{baseUrl}}/companies/{{companyId}}


### ─────────────────────────────────────────
### Get company — invalid UUID (expect 400)
### ─────────────────────────────────────────
GET {{baseUrl}}/companies/not-a-valid-uuid


### ─────────────────────────────────────────
### Get company — non-existent ID (expect 404)
### ─────────────────────────────────────────
GET {{baseUrl}}/companies/00000000-0000-0000-0000-000000000000


### ─────────────────────────────────────────
### Update company (recruiter — expect 200)
### ─────────────────────────────────────────
PUT {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "description": "Updated: Sri Lanka's fastest growing tech company.",
  "location": "Colombo 03, Sri Lanka"
}


### ─────────────────────────────────────────
### Update company — no token (expect 401)
### ─────────────────────────────────────────
PUT {{baseUrl}}/companies/{{companyId}}
Content-Type: application/json

{
  "description": "Should not work."
}


### ─────────────────────────────────────────
### Delete company (admin — expect 204)
### ─────────────────────────────────────────
# ⚠️  Run this last — deleting removes the company used by other tests
# DELETE {{baseUrl}}/companies/{{companyId}}
# Authorization: Bearer {{adminToken}}


### ─────────────────────────────────────────
### Delete company as recruiter (expect 403)
### ─────────────────────────────────────────
DELETE {{baseUrl}}/companies/{{companyId}}
Authorization: Bearer {{recruiterToken}}