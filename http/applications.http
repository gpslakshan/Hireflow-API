### Variables
@baseUrl = http://localhost:8080/api/v1
@candidateToken = <paste_candidate_token_here>
@recruiterToken = <paste_recruiter_token_here>
@jobId = <paste_open_job_id_here>
@applicationId = <paste_application_id_here>
@cvKey = <paste_cv_key_from_upload_url_response_here>


### ═══════════════════════════════════════════════════════════
###  CV UPLOAD FLOW
### ═══════════════════════════════════════════════════════════

### ─────────────────────────────────────────
### Step 1 — Request a pre-signed CV upload URL (candidate — expect 200)
### Copy upload_url and cv_key from the response
### ─────────────────────────────────────────
POST {{baseUrl}}/uploads/cv-upload-url
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "file_name": "alice-smith-cv.pdf"
}


### ─────────────────────────────────────────
### Step 2 — Upload PDF directly to S3
### Paste the full upload_url from Step 1 as the request URL
### No Authorization header needed — auth is embedded in the URL
### Body: binary → select your PDF file
### Expected: 200 OK with empty body (S3 response, not your API)
### ─────────────────────────────────────────
# PUT <paste_full_upload_url_here>
# Content-Type: application/pdf
# --data-binary "@/path/to/your-cv.pdf"
#
# Run this via curl in your terminal:
# curl -X PUT "<upload_url>" \
#   -H "Content-Type: application/pdf" \
#   --data-binary "@/path/to/alice-smith-cv.pdf"


### ─────────────────────────────────────────
### Get upload URL — non-PDF file (expect 400)
### ─────────────────────────────────────────
POST {{baseUrl}}/uploads/cv-upload-url
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "file_name": "my-cv.docx"
}


### ─────────────────────────────────────────
### Get upload URL — missing file_name (expect 422)
### ─────────────────────────────────────────
POST {{baseUrl}}/uploads/cv-upload-url
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{}


### ─────────────────────────────────────────
### Get upload URL — recruiter tries (expect 403)
### ─────────────────────────────────────────
POST {{baseUrl}}/uploads/cv-upload-url
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "file_name": "cv.pdf"
}


### ─────────────────────────────────────────
### Get upload URL — no token (expect 401)
### ─────────────────────────────────────────
POST {{baseUrl}}/uploads/cv-upload-url
Content-Type: application/json

{
  "file_name": "cv.pdf"
}


### ═══════════════════════════════════════════════════════════
###  APPLY TO A JOB
### ═══════════════════════════════════════════════════════════

### ─────────────────────────────────────────
### Apply to a job with CV (candidate — expect 201)
### Use the cv_key returned from the upload URL request
### Note: cv_download_url will be empty here — generated on fetch
### ─────────────────────────────────────────
POST {{baseUrl}}/jobs/{{jobId}}/apply
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "cover_letter": "I am very excited to apply for this role. I have 4 years of experience building REST APIs in Go and would love to contribute to your team.",
  "cv_key": "{{cvKey}}"
}


### ─────────────────────────────────────────
### Apply to a job without CV (candidate — expect 201)
### cv_key is optional — omit it entirely
### ─────────────────────────────────────────
POST {{baseUrl}}/jobs/{{jobId}}/apply
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "cover_letter": "I am applying without a CV attached."
}


### ─────────────────────────────────────────
### Apply to the same job again (expect 409 — already applied)
### ─────────────────────────────────────────
POST {{baseUrl}}/jobs/{{jobId}}/apply
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "cover_letter": "Trying to apply again."
}


### ─────────────────────────────────────────
### Apply to a closed job (expect 409 — job closed)
### First close the job using jobs.http, then run this
### ─────────────────────────────────────────
# POST {{baseUrl}}/jobs/{{jobId}}/apply
# Content-Type: application/json
# Authorization: Bearer {{candidateToken}}
#
# {
#   "cover_letter": "This job is closed."
# }


### ─────────────────────────────────────────
### Apply — recruiter tries (expect 403)
### ─────────────────────────────────────────
POST {{baseUrl}}/jobs/{{jobId}}/apply
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "cover_letter": "Recruiters cannot apply to jobs."
}


### ─────────────────────────────────────────
### Apply — no token (expect 401)
### ─────────────────────────────────────────
POST {{baseUrl}}/jobs/{{jobId}}/apply
Content-Type: application/json

{
  "cover_letter": "No auth provided."
}


### ─────────────────────────────────────────
### Apply — non-existent job (expect 404)
### ─────────────────────────────────────────
POST {{baseUrl}}/jobs/00000000-0000-0000-0000-000000000000/apply
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "cover_letter": "This job does not exist."
}


### ═══════════════════════════════════════════════════════════
###  FETCH APPLICATIONS
### ═══════════════════════════════════════════════════════════

### ─────────────────────────────────────────
### Get my applications (candidate — expect 200)
### Applications with a CV will include cv_download_url
### ─────────────────────────────────────────
GET {{baseUrl}}/applications/my
Authorization: Bearer {{candidateToken}}


### ─────────────────────────────────────────
### Get my applications — recruiter tries (expect 403)
### ─────────────────────────────────────────
GET {{baseUrl}}/applications/my
Authorization: Bearer {{recruiterToken}}


### ─────────────────────────────────────────
### Get my applications — no token (expect 401)
### ─────────────────────────────────────────
GET {{baseUrl}}/applications/my


### ─────────────────────────────────────────
### Get application by ID — as candidate (expect 200)
### cv_download_url will be populated if a CV was uploaded
### ─────────────────────────────────────────
GET {{baseUrl}}/applications/{{applicationId}}
Authorization: Bearer {{candidateToken}}


### ─────────────────────────────────────────
### Get application by ID — as recruiter who owns the job (expect 200)
### cv_download_url will be a fresh pre-signed S3 URL valid for 15 minutes
### ─────────────────────────────────────────
GET {{baseUrl}}/applications/{{applicationId}}
Authorization: Bearer {{recruiterToken}}


### ─────────────────────────────────────────
### Step 3 — Download the CV directly from S3
### Paste the cv_download_url from the response above as the request URL
### No Authorization header needed — auth is embedded in the URL
### Expected: 200 with PDF binary body
### ─────────────────────────────────────────
# GET <paste_full_cv_download_url_here>


### ─────────────────────────────────────────
### Get application — non-existent ID (expect 404)
### ─────────────────────────────────────────
GET {{baseUrl}}/applications/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{candidateToken}}


### ─────────────────────────────────────────
### Get all applications for a job (recruiter — expect 200)
### Each application with a CV will include cv_download_url
### ─────────────────────────────────────────
GET {{baseUrl}}/jobs/{{jobId}}/applications
Authorization: Bearer {{recruiterToken}}


### ─────────────────────────────────────────
### Get applications for a job — candidate tries (expect 403)
### ─────────────────────────────────────────
GET {{baseUrl}}/jobs/{{jobId}}/applications
Authorization: Bearer {{candidateToken}}


### ─────────────────────────────────────────
### Get applications for a job — no token (expect 401)
### ─────────────────────────────────────────
GET {{baseUrl}}/jobs/{{jobId}}/applications


### ═══════════════════════════════════════════════════════════
###  APPLICATION PIPELINE — STATUS PROGRESSION
### ═══════════════════════════════════════════════════════════

### ─────────────────────────────────────────
### Advance to screening (recruiter — expect 200)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "screening"
}


### ─────────────────────────────────────────
### Advance to interview (recruiter — expect 200)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "interview"
}


### ─────────────────────────────────────────
### Advance to offer (recruiter — expect 200)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "offer"
}


### ─────────────────────────────────────────
### Mark as hired (recruiter — expect 200)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "hired"
}


### ─────────────────────────────────────────
### Mark as rejected (recruiter — expect 200)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "rejected"
}


### ─────────────────────────────────────────
### Update status — set back to applied (expect 422)
### "applied" is set by the system only — not allowed via API
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "applied"
}


### ─────────────────────────────────────────
### Update status — invalid value (expect 422)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "pending"
}


### ─────────────────────────────────────────
### Update status — candidate tries (expect 403)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json
Authorization: Bearer {{candidateToken}}

{
  "status": "screening"
}


### ─────────────────────────────────────────
### Update status — no token (expect 401)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/{{applicationId}}/status
Content-Type: application/json

{
  "status": "screening"
}


### ─────────────────────────────────────────
### Update status — non-existent application (expect 404)
### ─────────────────────────────────────────
PATCH {{baseUrl}}/applications/00000000-0000-0000-0000-000000000000/status
Content-Type: application/json
Authorization: Bearer {{recruiterToken}}

{
  "status": "screening"
}


### ═══════════════════════════════════════════════════════════
###  WITHDRAW APPLICATION
###  ⚠️  Run these last — withdrawal hard-deletes the application
###      and cleans up the CV from S3
### ═══════════════════════════════════════════════════════════

### ─────────────────────────────────────────
### Withdraw — recruiter tries (expect 403)
### ─────────────────────────────────────────
DELETE {{baseUrl}}/applications/{{applicationId}}
Authorization: Bearer {{recruiterToken}}


### ─────────────────────────────────────────
### Withdraw — no token (expect 401)
### ─────────────────────────────────────────
DELETE {{baseUrl}}/applications/{{applicationId}}


### ─────────────────────────────────────────
### Withdraw — non-existent application (expect 404)
### ─────────────────────────────────────────
DELETE {{baseUrl}}/applications/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{candidateToken}}


### ─────────────────────────────────────────
### Withdraw application (candidate — expect 204)
### CV is deleted from S3 automatically if one was uploaded
### Verify in AWS Console: cvs/<candidateId>/alice-smith-cv.pdf should be gone
### ⚠️  Uncomment to run — permanently deletes the application
### ─────────────────────────────────────────
# DELETE {{baseUrl}}/applications/{{applicationId}}
# Authorization: Bearer {{candidateToken}}